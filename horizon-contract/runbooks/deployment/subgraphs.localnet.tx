
action "horizon_contract_funds_released" "svm::deploy_subgraph" {
    program_id = action.deploy_horizon_contract.program_id
    program_idl = action.deploy_horizon_contract.program_idl
    block_height = 0 // action.deploy_horizon_contract.block_height
    event {
        name = "FundsReleased"
    }
}

