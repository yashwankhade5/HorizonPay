modules = ["nodejs-20", "web", "bash", "postgresql-16"]

    [deployment]
    router = "application"
    deploymentTarget = "autoscale"

    [workflows]
    runButton = "HorizonPay"

    [[workflows.workflow]]
    name = "HorizonPay"
    author = "agent"

    [workflows.workflow.metadata]
    outputType = "webview"

    [[workflows.workflow.tasks]]
    task = "shell.exec"
    args = "PORT=25310 pnpm run dev"
    waitForPort = 25310

    [agent]
    stack = "PNPM_WORKSPACE"
    expertMode = true

    [nix]
    channel = "stable-25_05"
    